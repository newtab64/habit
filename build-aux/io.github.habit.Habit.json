{
  "app-id": "io.github.habit.Habit",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "habit",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/habit/cargo"
    }
  },
  "modules": [
    {
      "name": "habit",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline build --release --features ui",
        "install -Dm755 target/release/habit /app/bin/habit",
        "install -Dm644 data/io.github.habit.Habit.desktop /app/share/applications/io.github.habit.Habit.desktop",
        "install -Dm644 data/io.github.habit.Habit.metainfo.xml /app/share/metainfo/io.github.habit.Habit.metainfo.xml",
        "install -Dm644 data/icons/hicolor/scalable/apps/io.github.habit.Habit.svg /app/share/icons/hicolor/scalable/apps/io.github.habit.Habit.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [".git", "target", ".flatpak-builder", "build-dir", "repo", "habit.flatpak"]
        }
      ]
    }
  ]
}
